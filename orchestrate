#!/bin/sh
# Thin launcher: finds a Python 3.8+ and runs orchestrate.py next to this file.
d=$(cd "$(dirname "$0")" && pwd)
for p in python3 python; do
  if command -v "$p" >/dev/null 2>&1; then exec "$p" "$d/orchestrate.py" "$@"; fi
done
echo "orchestrate: Python 3.8+ was not found. Install it from https://www.python.org/downloads/" >&2
exit 127
