# Copy to .env and fill in. Never commit .env.
# Slack (Member 1)
SLACK_WEBHOOK_URL=
# Resend email (Member 2)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Optional advisory language-model layer (python code/advise.py --model). Leave empty to run without any model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: USD per million tokens, used only to estimate cost in usage_report.md
ANTHROPIC_PRICE_INPUT_PER_MTOK=
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=
