# Copy to .env and fill in. Never commit .env.
# Slack (Member 1)
SLACK_WEBHOOK_URL=
# Resend email (Member 2)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Who may draft, approve and send email: run `python code/email_operator_token.py --name <Name> --env-file .env` (stores only a hash).
EMAIL_OPERATORS=
# Live email may only go to these addresses or whole domains (comma separated). Empty = every email route is disabled.
EMAIL_ALLOWED_RECIPIENTS=
# Set to 1 only for a one-person demo: lets the person who drafted an email also approve it. Leave empty otherwise.
EMAIL_ALLOW_SELF_APPROVAL=
# Optional: where the email outbox (SQLite) lives. Defaults to email_outbox.db in the working directory; it is gitignored.
EMAIL_DB_PATH=
# Optional advisory language-model layer (python code/advise.py --model). Leave empty to run without any model.
# Any OpenAI-compatible gateway: base URL ends in /v1; model is the exact model id your provider lists.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER_NAME=
# Only if LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional: USD per million tokens, used only to estimate cost in usage_report.md
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
